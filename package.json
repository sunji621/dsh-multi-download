{
  "name": "dsh-multi-download",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "多线程下载器插件：给 agent 两个工具 download_file / download_task，用 HTTP Range 分段并发下载、断点续传、进度与取消。零依赖（只用 Node 内置 fetch/fs）。",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "download", "multi-connection", "http-range"],
  "license": "MIT",
  "engines": { "node": ">=20" },
  "icon": "./icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node tests/run.mjs"
  }
}
